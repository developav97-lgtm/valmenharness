{
  "name": "valmenharness",
  "version": "0.0.1",
  "private": true,
  "description": "Harness agéntico empresarial: motor determinista de estado, especificaciones y gates configurables para proyectos con desarrollo agéntico.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rm -rf packages/*/dist .tsbuildinfo packages/*/*.tsbuildinfo",
    "build": "tsc --build tsconfig.build.json && node scripts/publicar-web.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run build && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/developav97-lgtm/valmenharness.git"
  },
  "keywords": [
    "agentic",
    "harness",
    "workflow",
    "spec-driven-development",
    "ai-agents",
    "tickets",
    "gates"
  ]
}
