{
  "name": "@valmen/mcp",
  "version": "0.0.1",
  "description": "Servidor MCP del harness: deja que un agente cree tickets y mueva el registro sin que nadie escriba comandos.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "valmen-mcp": "./dist/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@valmen/adapter": "0.0.1",
    "@valmen/cli": "0.0.1",
    "@valmen/core": "0.0.1",
    "@valmen/credentials": "0.0.1",
    "@valmen/engine": "0.0.1",
    "@valmen/gate": "0.0.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}
