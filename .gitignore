node_modules/
dist/
coverage/
*.tsbuildinfo

# Estado derivado del harness: siempre reconstruible con `valmen index`.
.valmen/state/

# Secretos: nunca versionar credenciales ni configuración local.
.env
.env.local
*.local.yaml

# macOS
.DS_Store

# Lo que produce `valmen sync`: la proyección de .valmen/ a los archivos que leen
# los agentes. La fuente es .valmen/ y esto se regenera; versionarlo obligaría a
# revisar dos veces el mismo contenido y a mantener las dos copias de acuerdo.
# Se comprueba con `valmen sync --check`.
.codex/
.opencode/
.claude/

# La configuración de opencode la genera `valmen mcp --install` y cada proyecto
# decide si la versiona. Aquí es configuración del entorno de trabajo.
opencode.json

# La convención cross-tool de skills, que leen Hermes y otros CLIs.
.agents/

# El lanzador de Mission Control que vive en la raíz. Es de la máquina y no del
# repositorio: cada proyecto tiene el suyo, con su raíz y su rango de puertos, y
# versionarlo obligaría a mantener una copia por proyecto dentro del harness.
Abrir pantalla.command
